# Real-mode image: torch on CPU, no CUDA.
#
# The CPU-only torch wheel is installed from the cpu index deliberately: the
# default wheel pulls ~2.5 GB of CUDA libraries that cannot be used here and
# would make every container image, and every container start, far heavier than
# the experiment can afford when ten of them share one host.
#
# Versions are pinned. Transformers moved rotary-embedding computation into
# Qwen2Model between releases, and the stage worker builds a sliced Qwen2Model
# directly, so an unpinned upgrade could silently change what a stage computes.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 iputils-ping curl \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.5.1"

RUN pip install --no-cache-dir \
      "aiohttp==3.10.11" \
      "transformers==4.46.3" \
      "safetensors==0.4.5" \
      "tokenizers==0.20.3" \
      "numpy==2.1.3"

WORKDIR /app
COPY swarm /app/swarm
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

ENTRYPOINT ["/app/entrypoint.sh"]
